{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickatime",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/privacy-policy", "/privacy-policy.html", "/privacy-policy/en", "/privacy-policy/ko", "/terms-of-service", "/admin"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "logs": {"enabled": true, "invocation_logs": false}
  }
}
